# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# ---- providers ---------------------------------------------------------------
PROVIDER_MODE=fake              # fake works without API keys; openai enables the configured remote chat provider
EMBEDDING_PROVIDER=auto         # auto | openai | local (fastembed, no key) | hashing
LLM_PROVIDER=groq                # groq | openai
LLM_API_KEY=                   # Groq API key for chat generation
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=20
EMBEDDING_API_KEY=               # separate key for an embeddings API (Groq chat API does not provide embeddings)
# EMBEDDING_BASE_URL=            # optional OpenAI-compatible embeddings endpoint; defaults to OpenAI
EMBEDDING_MODEL=text-embedding-3-small

# ---- RAG knobs (defaults; experiments override per run) --------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
HYBRID=false                    # dense + BM25 with reciprocal-rank fusion
RERANKER=none                   # none | lexical
PROMPT_VERSION=v2               # v1 | v2 (see app/prompts.py)

# ---- storage -----------------------------------------------------------------------
DATA_DIR=data
# QDRANT_URL=http://localhost:6333   # recommended for production; embedded mode is single-process only
# QDRANT_PATH=data/qdrant

# ---- Langfuse (https://langfuse.com) ----------------------------------------------------
LANGFUSE_ENABLED=false          # optional; requires Langfuse project credentials
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com / your self-hosted URL
LANGFUSE_ENVIRONMENT=development           # development | staging | production
# LANGFUSE_RELEASE=

# ---- online evaluation (async worker) -------------------------------------------------------
ONLINE_EVAL_ENABLED=false       # online judging requires API credentials and a running worker
ONLINE_EVAL_SAMPLE_RATE=1.0     # 0.0-1.0: lower it to control judge-LLM cost in production
EVAL_MAX_ATTEMPTS=3
EVAL_RETRY_BASE_SECONDS=30
JUDGE_MODEL=openai/gpt-oss-20b  # Groq-compatible judge model; use a different model to reduce self-preference bias
JUDGE_EMBEDDING_MODEL=text-embedding-3-small

# ---- privacy / cost -----------------------------------------------------------------------------
REDACT_PII=true                 # mask emails, phones, key-like strings in traces and the eval queue
# PRICING_JSON={"gpt-4o-mini": {"input_per_1m": 0.15, "output_per_1m": 0.60}}
